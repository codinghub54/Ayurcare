# =============================================================
# AyurCare — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
# =============================================================

# Database (Neon PostgreSQL)
DATABASE_URL=                          # Neon pooled connection string (postgresql://user:pass@...pooler.../db?sslmode=require)

# Authentication Secrets
JWT_SECRET=                            # Random 48+ char secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_REFRESH_SECRET=                    # Random 48+ char secret, different from JWT_SECRET

# Mandatory SMS second factor for every admin password login (Twilio Messaging API)
TWILIO_ACCOUNT_SID=                    # Twilio Account SID (AC...)
TWILIO_AUTH_TOKEN=                     # Rotated Twilio Auth Token; keep secret
TWILIO_FROM_NUMBER=                    # SMS-capable Twilio number in E.164 format
ADMIN_LOGIN_OTP_PHONE=                 # Fixed admin destination in E.164 format

# Email / SMTP (Gmail App Password)
SMTP_FROM_EMAIL=                       # e.g. prakritiai.connect@gmail.com
SMTP_PASSWORD=                         # Gmail App Password (not the regular account password)
SMTP_HOST=smtp.gmail.com               # SMTP server hostname
SMTP_PORT=587                          # SMTP port (587 for TLS)

# AI Services
GEMINI_API_KEY=                        # Google Gemini API key

# Payments (Razorpay - use TEST keys (rzp_test_...) until you are ready to go live)
RAZORPAY_KEY_ID=                       # Razorpay Key ID (rzp_test_... / rzp_live_...)
RAZORPAY_KEY_SECRET=                   # Razorpay Key Secret - server only, never expose
RAZORPAY_WEBHOOK_SECRET=               # Optional: secret set on the Razorpay webhook (/api/webhooks/razorpay)

# Google OAuth
GOOGLE_CLIENT_ID=                      # Google OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=          # Same as above (exposed to browser)

# Server
PORT=3000                              # Local dev server port
